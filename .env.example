DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/pqprep

# Question writing: first provider is tried first, the others take over if it is rate-limited or down.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_FALLBACK=mistral,gemini
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# VERIFY_ANSWERS=off            (skips the background answer check; saves about a third of the AI usage per exam)
# LLM_REASONING_EFFORT=low       (faster on reasoning models such as gpt-oss; remove if the provider rejects it)
# GROQ_MODEL= / MISTRAL_MODEL= / GEMINI_MODEL=   (override a provider's default model)

# Embeddings (changing provider later means re-uploading sources)
EMBED_PROVIDER=openrouter
OPENROUTER_API_KEY=
